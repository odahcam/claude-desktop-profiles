#!/bin/zsh
# cdp — Claude Desktop Profiles
#
# Runs multiple Claude Desktop accounts side by side on macOS by giving each
# profile its own --user-data-dir, and makes each profile launchable from
# Spotlight in two ways:
#
#   1. A per-profile launcher app:  "Claude Work.app", "Claude Personal.app"
#   2. A single chooser app:        "Claude Profiles.app" — a native picker
#      dialog that lists every profile (plus your default install) and can
#      also add and remove profiles without touching the terminal.
#
# Profiles are discovered by convention, not by a registry file: any folder
# matching ~/Library/Application Support/Claude-<Name> is a profile. Delete
# the folder and the launcher app, and the profile is gone.
#
# The chooser bundles a copy of this script in its Resources and shells out
# to it for add/remove, so GUI and CLI share one implementation.
#
# No dependencies beyond what ships with macOS (osacompile, PlistBuddy).

set -euo pipefail

# Resolved at file scope: inside functions zsh rebinds $0 to the function name
# (FUNCTION_ARGZERO), which would break the self-copy into the chooser bundle.
SCRIPT_PATH="${0:A}"

CDP_VERSION="0.4.2"

APP_SUPPORT="$HOME/Library/Application Support"
LAUNCHER_DIR="$HOME/Applications"
BUNDLE_PREFIX="com.claude-desktop-profiles"
CHOOSER_NAME="Claude Profiles"
CACHE_DIR="$HOME/Library/Caches/claude-desktop-profiles"
# Per-profile clones of Claude.app (APFS copy-on-write) live here, outside
# Spotlight's index, so nobody launches one without its --user-data-dir.
CLONES_DIR="$APP_SUPPORT/claude-desktop-profiles/apps"
# LaunchAgent running `cdp watch`: re-homes clones that got relaunched
# without their --user-data-dir (see adopt_strays).
WATCH_LABEL="${CDP_WATCH_LABEL:-$BUNDLE_PREFIX.watch}"  # override: tests
WATCH_PLIST="$HOME/Library/LaunchAgents/$WATCH_LABEL.plist"

# Per-profile icon colors: hue rotation (degrees) applied to Claude's icon.
# The white spark is unaffected by hue shifts; only the orange square moves.
# A profile's color lives in <dataDir>/.cdp-color so it travels with the
# profile folder — consistent with the no-registry design.
typeset -A HUES=(
  orange 0
  red    -25
  yellow 40
  green  110
  teal   160
  blue   200
  purple 250
  pink   310
)

# ---- helpers ---------------------------------------------------------------

err()  { print -u2 -- "✗ $*"; exit 1 }
ok()   { print -- "✓ $*" }
info() { print -- "ℹ $*" }
warn() { print -u2 -- "⚠ $*" }

find_claude_app() {
  local c
  for c in "/Applications/Claude.app" "$HOME/Applications/Claude.app"; do
    [[ -d "$c" ]] && { print -- "$c"; return }
  done
  err "Claude.app not found in /Applications or ~/Applications."
}

# "client acme" -> slug "client-acme", display "Client Acme"
slugify() {
  print -- "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

displayify() {
  local out=() part
  for part in ${(s:-:)1}; do out+=("${(C)part}"); done
  print -- "${(j: :)out}"
}

# The manager app ("Claude Profiles"): the downloaded release in
# /Applications or a local build in ~/Applications. Prefers the copy running
# this script, so launchers and CLI symlinks find the same one.
manager_app() {
  local c
  for c in "${SCRIPT_PATH:h:h:h}" "/Applications/$CHOOSER_NAME.app" "$LAUNCHER_DIR/$CHOOSER_NAME.app"; do
    [[ "${c:t}" == "$CHOOSER_NAME.app" && -d "$c" ]] && { print -- "$c"; return 0 }
  done
  return 1
}

# The SwiftUI manager, as opposed to the AppleScript chooser at the same name.
is_swiftui_manager() {
  [[ -x "$1/Contents/MacOS/ClaudeProfiles" ]]
}

# Compiles Swift sources into one binary for each arch in $CDP_ARCHS (default:
# this Mac's), merged with lipo. The release sets CDP_ARCHS="arm64 x86_64".
swift_compile() {
  local out="$1" arch
  shift
  local -a slices=()
  for arch in ${=CDP_ARCHS:-$(uname -m)}; do
    swiftc -O -target "$arch-apple-macos13.0" -o "$out.$arch" "$@" || return 1
    slices+=("$out.$arch")
  done
  lipo -create -output "$out" $slices
  rm -f $slices
}

# Caches the small Swift helper for icon tinting, Finder icons and window
# focus. Release builds ship it prebuilt inside the manager app, so no Xcode
# tools are needed; otherwise it is compiled, which needs swiftc. Callers fall
# back without it.
#
# It lives inside a minimal .app bundle, not as a bare binary: macOS names a
# process after the bundle it runs from, so Activity Monitor, TCC prompts and
# any Dock flash show "Claude Profiles Helper" with the manager's grid icon
# instead of an anonymous "tinticon".
HELPER_NAME="$CHOOSER_NAME Helper"
ensure_tint_tool() {
  local bundle="$CACHE_DIR/$HELPER_NAME.app"
  local tool="$bundle/Contents/MacOS/$HELPER_NAME"
  local icns="$bundle/Contents/Resources/AppIcon.icns"
  if [[ -x "$tool" && ! "$SCRIPT_PATH" -nt "$tool" ]]; then
    [[ -f "$icns" ]] || helper_icon "$tool" "$icns"
    print -- "$tool"
    return 0
  fi
  local m prebuilt
  m=$(manager_app) && prebuilt="$m/Contents/Resources/$HELPER_NAME.app"
  if [[ -n "$prebuilt" && -x "$prebuilt/Contents/MacOS/$HELPER_NAME" ]]; then
    # The copy drops the download's quarantine flag: launchers exec the
    # helper outside the manager app the user approved in Gatekeeper, and
    # macOS kills a quarantined, unnotarized binary on exec. ditto --noqtn
    # does not remove it.
    rm -rf "$bundle"
    mkdir -p "$CACHE_DIR"
    ditto "$prebuilt" "$bundle"
    xattr -dr com.apple.quarantine "$bundle" 2>/dev/null || true
    touch "$tool"
  else
    build_helper "$bundle" 2>/dev/null || return 1
  fi
  helper_icon "$tool" "$icns"
  print -- "$tool"
}

# Writes the helper .app bundle to $1. Needs swiftc.
build_helper() {
  local bundle="$1" tmp
  local tool="$bundle/Contents/MacOS/$HELPER_NAME"
  command -v swiftc >/dev/null 2>&1 || return 1
  tmp=$(mktemp -d)
  cat > "$tmp/helper.swift" <<'EOF'
import AppKit
import CoreImage

// helper tint <src.icns> <dst.icns> <hueDegrees>   hue-rotated copy
// helper grid <src.icns> <dst.icns>                quartered multi-hue manager icon
// helper seticon <icon> <target>                   Finder custom icon (Dock honors it,
//                                                  and it does not break code signatures)
// helper focus <pid>                               activate a running app by pid
let a = CommandLine.arguments
guard a.count >= 3 else { exit(2) }
let mode = a[1]

if mode == "focus" {
    guard let pid = Int32(a[2]),
          let ra = NSRunningApplication(processIdentifier: pid) else { exit(3) }
    ra.activate(options: [.activateAllWindows, .activateIgnoringOtherApps])
    exit(0)
}
if mode == "seticon" {
    guard a.count >= 4, let img = NSImage(contentsOfFile: a[2]) else { exit(2) }
    exit(NSWorkspace.shared.setIcon(img, forFile: a[3], options: []) ? 0 : 3)
}
guard a.count >= 4, let src = NSImage(contentsOfFile: a[2]) else { exit(2) }
let dst = a[3]
let iconset = URL(fileURLWithPath: NSTemporaryDirectory())
    .appendingPathComponent("tint-\(ProcessInfo.processInfo.processIdentifier).iconset")
try! FileManager.default.createDirectory(at: iconset, withIntermediateDirectories: true)

func tintedCG(_ hue: Double, px: Int) -> CGImage? {
    guard let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px,
                                     bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
                                     isPlanar: false, colorSpaceName: .calibratedRGB,
                                     bytesPerRow: 0, bitsPerPixel: 0) else { return nil }
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
    src.draw(in: CGRect(x: 0, y: 0, width: px, height: px))
    NSGraphicsContext.restoreGraphicsState()
    guard let ci = CIImage(bitmapImageRep: rep) else { return nil }
    var out = ci
    if hue != 0 {
        let f = CIFilter(name: "CIHueAdjust")!
        f.setValue(ci, forKey: kCIInputImageKey)
        f.setValue(hue * .pi / 180, forKey: kCIInputAngleKey)
        guard let o = f.outputImage else { return nil }
        out = o
    }
    return CIContext().createCGImage(out, from: CGRect(x: 0, y: 0, width: px, height: px))
}

func emit(_ size: Int, _ scale: Int) {
    let px = size * scale
    guard let canvas = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px,
                                        bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
                                        isPlanar: false, colorSpaceName: .calibratedRGB,
                                        bytesPerRow: 0, bitsPerPixel: 0),
          let ctx = NSGraphicsContext(bitmapImageRep: canvas) else { return }
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = ctx
    if mode == "grid" {
        // One full-size Claude icon, quartered: each quadrant shows the same
        // icon in a different hue. Full render clipped per quadrant, so the
        // artwork lines up seamlessly across the color boundaries.
        // Top-left orange, top-right blue, bottom-left green, bottom-right
        // purple (rects below are in CG bottom-left coordinates).
        let half = Double(px) / 2
        let quadrants: [(Double, CGRect)] = [
            (0,   CGRect(x: 0,    y: half, width: half, height: half)),
            (200, CGRect(x: half, y: half, width: half, height: half)),
            (110, CGRect(x: 0,    y: 0,    width: half, height: half)),
            (250, CGRect(x: half, y: 0,    width: half, height: half)),
        ]
        let full = CGRect(x: 0, y: 0, width: px, height: px)
        for (hue, rect) in quadrants {
            guard let cg = tintedCG(hue, px: px) else { continue }
            ctx.cgContext.saveGState()
            ctx.cgContext.clip(to: rect)
            ctx.cgContext.draw(cg, in: full)
            ctx.cgContext.restoreGState()
        }
    } else {
        let hue = a.count > 4 ? (Double(a[4]) ?? 0) : 0
        if let cg = tintedCG(hue, px: px) {
            ctx.cgContext.draw(cg, in: CGRect(x: 0, y: 0, width: px, height: px))
        }
    }
    NSGraphicsContext.restoreGraphicsState()
    guard let png = canvas.representation(using: .png, properties: [:]) else { return }
    let name = scale == 1 ? "icon_\(size)x\(size).png" : "icon_\(size)x\(size)@2x.png"
    try? png.write(to: iconset.appendingPathComponent(name))
}
for s in [16, 32, 128, 256, 512] { emit(s, 1); emit(s, 2) }
let p = Process()
p.executableURL = URL(fileURLWithPath: "/usr/bin/iconutil")
p.arguments = ["-c", "icns", iconset.path, "-o", dst]
try! p.run(); p.waitUntilExit()
try? FileManager.default.removeItem(at: iconset)
exit(p.terminationStatus)
EOF
  rm -rf "$bundle"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
  swift_compile "$tool" "$tmp/helper.swift" || { rm -rf "$tmp"; return 1 }
  rm -rf "$tmp"
  cat > "$bundle/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>CFBundleExecutable</key><string>$HELPER_NAME</string>
	<key>CFBundleIdentifier</key><string>$BUNDLE_PREFIX.helper</string>
	<key>CFBundleName</key><string>$HELPER_NAME</string>
	<key>CFBundleDisplayName</key><string>$HELPER_NAME</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>LSUIElement</key><true/>
</dict></plist>
EOF
  /usr/bin/codesign --force --sign - "$bundle" 2>/dev/null
}

# The helper's own icon is the same multi-hue grid as the manager app. Skipped
# silently when Claude.app is missing; retried on the next call. Re-signs the
# bundle, whose seal the new resource broke.
helper_icon() {
  local tool="$1" out="$2" claude_app src
  claude_app=$(find_claude_app 2>/dev/null) || return 0
  src=$(print -l -- "$claude_app/Contents/Resources"/*.icns(N) | head -1)
  [[ -n "$src" ]] && "$tool" grid "$src" "$out" 2>/dev/null &&
    /usr/bin/codesign --force --sign - "${tool:h:h:h}" 2>/dev/null || true
}

# Writes the profile icon (hue-rotated when hue != 0 and swiftc is available,
# Claude's own icon otherwise) to the given path. Returns 1 if no source icon.
make_icns() {
  local claude_app="$1" hue="$2" out="$3" icns tool
  icns=$(print -l -- "$claude_app/Contents/Resources"/*.icns(N) | head -1)
  [[ -n "$icns" ]] || return 1
  if [[ "$hue" != "0" ]]; then
    if tool=$(ensure_tint_tool) && "$tool" tint "$icns" "$out" "$hue" 2>/dev/null; then
      return 0
    fi
    warn "Could not tint icon (swiftc missing?). Using the plain Claude icon."
  fi
  cp "$icns" "$out"
}

# The manager app's own icon: a 2x2 multi-hue grid so the Dock/Spotlight
# entry is distinguishable from an actual Claude instance. Falls back to
# the plain Claude icon when swiftc is unavailable.
make_manager_icns() {
  local claude_app="$1" out="$2" icns tool
  icns=$(print -l -- "$claude_app/Contents/Resources"/*.icns(N) | head -1)
  [[ -n "$icns" ]] || return 1
  if tool=$(ensure_tint_tool) && "$tool" grid "$icns" "$out" 2>/dev/null; then
    return 0
  fi
  cp "$icns" "$out"
}

hue_for_color() {
  print -- "${HUES[$1]:-0}"
}

app_version() {
  /usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$1/Contents/Info.plist" 2>/dev/null || print -- "?"
}

# Ordered compare of dotted-numeric versions: `version_lt A B` is true when A
# is strictly older than B. Used so we never DOWNGRADE a clone — a profile
# self-updates via Squirrel into its own bundle, and a plain `!=` check would
# treat "clone newer than the installed Claude" as drift and re-clone from the
# older /Applications, reverting the update (the app would then re-download it
# forever, losing its custom icon each cycle).
version_lt() {
  [[ "$1" == "$2" ]] && return 1
  local first
  first=$(print -l -- "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n 2>/dev/null | head -1)
  [[ "$first" == "$1" ]]
}

# A bundle carries its Finder custom icon (our profile color) as an `Icon\r`
# file inside the bundle dir. A Squirrel self-update replaces the bundle and
# drops it, so its absence on a colored profile means "self-updated since we
# last touched it".
has_custom_icon() {
  [[ -f "$1/Icon"$'\r' ]]
}

# PID of the main Claude process using this data dir (any bundle — original
# or clone), empty when not running. The trailing `|| true` matters: under
# `set -euo pipefail` a no-match grep (exit 1) would otherwise kill the
# whole script at the call site's assignment.
instance_pid() {
  ps -axo pid=,command= 2>/dev/null | grep -F -- "--user-data-dir=$1" | grep -F "/Contents/MacOS/Claude" | grep -v Helper | grep -v grep | awk '{print $1}' | head -1 || true
}

# Claude Code's config dir for this profile. --user-data-dir only scopes
# Electron's userData; the Claude Code that Desktop embeds (Code/Cowork tab)
# reads CLAUDE_CONFIG_DIR from the Desktop process env and otherwise shares
# ~/.claude, ~/.claude.json and the CLI keychain item with every other
# profile AND the terminal CLI — which is how one profile's account email
# ended up in unrelated `claude` sessions. Lives inside the data dir so it
# travels with the profile.
config_dir_of_profile() {
  print -- "$1/claude-config"
}

# Starts the clone with the profile's data dir AND a private Claude Code
# config dir. Exec'd directly instead of `open`: `open` hands LaunchServices
# a clean env, so CLAUDE_CONFIG_DIR would never reach the app. The env is
# reset to what launchd would give a Spotlight-launched app, so nothing from
# the calling shell (a terminal, a Claude Code session) leaks in either.
launch_clone() {
  local clone="$1" data_dir="$2" cfg
  cfg=$(config_dir_of_profile "$data_dir")
  # Hard invariant: a clone process must never exist without BOTH its
  # --user-data-dir and its CLAUDE_CONFIG_DIR. Refuse rather than start a
  # process that would fall back to the shared/default identity.
  [[ -n "$data_dir" && -n "$cfg" ]] || err "Refusing to launch: empty data or config dir."
  [[ -x "$clone/Contents/MacOS/Claude" ]] || err "Refusing to launch: clone binary missing at $clone."
  mkdir -p "$cfg"
  nohup /usr/bin/env -i \
    HOME="$HOME" USER="$USER" LOGNAME="$USER" SHELL="${SHELL:-/bin/zsh}" \
    PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    TMPDIR="$(getconf DARWIN_USER_TEMP_DIR)" LANG="${LANG:-en_US.UTF-8}" \
    ${SSH_AUTH_SOCK:+SSH_AUTH_SOCK="$SSH_AUTH_SOCK"} \
    CLAUDE_CONFIG_DIR="$cfg" \
    "$clone/Contents/MacOS/Claude" --user-data-dir="$data_dir" >/dev/null 2>&1 &!
}

# Clone processes running WITHOUT --user-data-dir, as "pid<TAB>Display".
# Squirrel's post-update relaunch (ShipIt) — and a click on a Dock/Recents
# entry — start the bundle by URL with no argv and no env, so the clone
# comes up on the DEFAULT userData: default account, orange Dock icon, but
# still titled "Claude <Profile>". Args are the only thing `ps` lets us
# check (hardened runtime hides env), and both are dropped together.
stray_pids() {
  local line pid cmd rest display
  ps -axo pid=,command= 2>/dev/null | grep -F -- "$CLONES_DIR/" | grep -F "/Contents/MacOS/Claude" | grep -v Helper | grep -v grep | grep -vF -- "--user-data-dir=" | while IFS= read -r line; do
    pid="${line##[[:space:]]#}"; pid="${pid%% *}"
    cmd="${line#*"$CLONES_DIR/"}"
    display="${${cmd%%.app/Contents/MacOS/Claude*}#Claude }"
    [[ -n "$display" ]] && print -- "$pid"$'\t'"$display"
  done || true
}

# Quits every stray clone and relaunches it as its profile. Idempotent:
# converges to "every clone process carries its --user-data-dir".
adopt_strays() {
  local entry pid display i
  stray_pids | while IFS=$'\t' read -r pid display; do
    info "Clone '$display' is running without its profile (post-update relaunch?) — re-homing."
    kill -TERM "$pid" 2>/dev/null || continue
    for i in {1..30}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    sleep 1
    launch_profile "$display" || true
  done
}

# Sets the clone's Finder custom icon to the profile color. Finder icons are
# metadata — the Developer ID signature stays valid, which is the entire
# reason clones are safe: Keychain keeps trusting the app.
apply_clone_icon() {
  local claude_app="$1" clone="$2" color="$3" tool tmp
  tool=$(ensure_tint_tool) || return 0
  tmp=$(mktemp -d)
  if make_icns "$claude_app" "$(hue_for_color "$color")" "$tmp/icon.icns"; then
    "$tool" seticon "$tmp/icon.icns" "$clone" 2>/dev/null || true
  fi
  rm -rf "$tmp"
}

# Brings the profile's Claude.app clone into a good state WITHOUT ever
# downgrading it. A profile self-updates via Squirrel into this very clone, so
# the clone may legitimately be AHEAD of /Applications; re-cloning from the
# older original would revert that update and trap the app in a re-download
# loop. Rules:
#   - clone missing              -> clone
#   - clone older than original  -> re-clone (move it forward)
#   - clone == original but the
#     self-update wiped its icon  -> re-clone (reclaim APFS sharing + recolor)
#   - clone ahead of original     -> leave the newer bundle, just restore icon
ensure_clone() {
  local claude_app="$1" clone="$2" color="$3"
  local ov cv reclone=0
  ov=$(app_version "$claude_app")
  cv=$(app_version "$clone")

  if [[ ! -d "$clone" ]]; then
    reclone=1
  elif [[ "$ov" != "?" && "$cv" != "?" ]] && version_lt "$cv" "$ov"; then
    reclone=1
  elif [[ "$cv" == "$ov" && "$color" != "orange" ]] && ! has_custom_icon "$clone"; then
    reclone=1
  fi

  # Claude's updater can replace the clone in place as root (seen on
  # 2.26454.2), leaving a bundle we can neither refresh nor re-icon; the rm
  # would fail file by file and the launch would die silently.
  if [[ -d "$clone" ]] && { (( reclone )) || { [[ "$color" != "orange" ]] && ! has_custom_icon "$clone" } }; then
    [[ -z "$(find "$clone" ! -user "$USER" -print -quit 2>/dev/null)" ]] ||
      err "Profile app clone is not owned by you (Claude's updater ran as root). Fix: sudo rm -rf '$clone'"
  fi

  if (( reclone )); then
    info "Refreshing profile app clone (APFS copy-on-write)…"
    rm -rf "$clone"
    mkdir -p "${clone:h}"
    /bin/cp -Rc "$claude_app" "$clone" 2>/dev/null || /bin/cp -R "$claude_app" "$clone"
    apply_clone_icon "$claude_app" "$clone" "$color"
  elif [[ "$color" != "orange" ]] && ! has_custom_icon "$clone"; then
    # Clone is at/ahead of /Applications (self-updated) — keep the newer bundle
    # intact and only restore the color the update dropped.
    apply_clone_icon "$claude_app" "$clone" "$color"
  fi
}

color_of_profile() {
  # Reads <dataDir>/.cdp-color; empty/missing means orange (untinted).
  local f="$1/.cdp-color"
  [[ -f "$f" ]] && print -- "$(head -1 "$f" | tr -d '[:space:]')" || print -- "orange"
}

# Compile an AppleScript source file into a .app with our bundle id and the
# Claude icon (optionally hue-tinted), replacing any existing bundle.
# --stay-open builds a stay-open applet (persistent Dock tile).
compile_launcher() {
  local src="$1" app_path="$2" bundle_id="$3" claude_app="$4" hue="${5:-0}"
  local -a osaflags=()
  [[ "${6:-}" == "--stay-open" ]] && osaflags+=(-s)

  [[ -d "$app_path" ]] && rm -rf "$app_path"
  mkdir -p "${app_path:h}"
  /usr/bin/osacompile $osaflags -o "$app_path" "$src"

  local plist="$app_path/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $bundle_id" "$plist" 2>/dev/null ||
    /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $bundle_id" "$plist"

  # osacompile bundles an Assets.car whose built-in applet icon outranks
  # applet.icns for the RUNNING app's Dock tile (Finder/Spotlight still show
  # the icns, which makes this easy to miss). Remove the catalog and its
  # Info.plist reference so our tinted icns is the only icon source.
  rm -f "$app_path/Contents/Resources/Assets.car"
  /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$plist" 2>/dev/null || true

  # Reuse Claude's own icon so the launcher is recognizable in Spotlight/Dock.
  if [[ -f "$app_path/Contents/Resources/applet.icns" ]]; then
    make_icns "$claude_app" "$hue" "$app_path/Contents/Resources/applet.icns" || true
    /usr/bin/touch "$app_path"
  fi

  # Editing Info.plist/Resources above broke osacompile's ad-hoc signature
  # seal; without a fresh signature Gatekeeper can report the app as damaged.
  /usr/bin/codesign --force --sign - "$app_path" 2>/dev/null || true
}

profile_dirs() {
  print -l -- "$APP_SUPPORT"/Claude-*(N/)
}

# When the chooser/GUI app invokes us (CDP_FROM_CHOOSER=1) we must not rebuild
# the chooser: we'd be rm -rf'ing the bundle that is currently running us.
# We also skip when the installed "Claude Profiles" is the compiled SwiftUI
# app — rebuilding would silently downgrade it to the AppleScript dialog.
rebuild_chooser_unless_nested() {
  [[ "${CDP_FROM_CHOOSER:-}" == "1" ]] && return 0
  local m
  m=$(manager_app) && is_swiftui_manager "$m" && return 0
  cmd_chooser --quiet
}

# The launcher is a fire-and-forget button: it calls the bundled cdp's
# `launch`, which starts the profile from its own Claude.app clone (whose
# Dock tile wears the profile color and owns the window) or focuses the
# already-running instance, then the applet exits. stderr stays attached so
# a failed launch surfaces as an alert instead of dying silently.
build_launcher() {
  local slug="$1" display="$2" color="$3" claude_app="$4" tmp
  local app_path="$LAUNCHER_DIR/Claude $display.app"
  tmp=$(mktemp -d)
  cat > "$tmp/launcher.applescript" <<EOF
on run
	try
		do shell script "/bin/zsh " & quoted form of (POSIX path of (path to me) & "Contents/Resources/cdp") & " launch " & quoted form of "$slug" & " > /dev/null"
	on error msg
		display alert "Could not launch Claude $display" message msg as critical
	end try
end run
EOF
  compile_launcher "$tmp/launcher.applescript" "$app_path" "$BUNDLE_PREFIX.$slug" "$claude_app" "$(hue_for_color "$color")"
  rm -rf "$tmp"

  # Bundle cdp so the launcher drives the same launch path as the GUI and
  # CLI, then re-sign (the copy broke the seal).
  bundle_cdp "$app_path"
  /usr/bin/codesign --force --sign - "$app_path" 2>/dev/null || true
}

# Copies this script into the bundle's Resources. A cdp from the downloaded
# app carries its quarantine flag, which every copy inherits (even cp -X).
bundle_cdp() {
  local dst="$1/Contents/Resources/cdp"
  cp "$SCRIPT_PATH" "$dst"
  chmod +x "$dst"
  xattr -d com.apple.quarantine "$dst" 2>/dev/null || true
}

# Every installed piece carries a copy of (or runs) this script: the manager
# app, each profile launcher, the watchdog process and the helper. Installing
# the manager brings all of them to this version so an update never leaves
# an old copy behind. Launchers whose profile has no launcher (removed with
# --keep-data) stay removed.
sync_install() {
  local claude_app d display
  claude_app=$(find_claude_app)
  for d in "$APP_SUPPORT"/Claude-*(N/); do
    display="${${d:t}#Claude-}"
    [[ -d "$LAUNCHER_DIR/Claude $display.app" ]] || continue
    build_launcher "$(slugify "$display")" "$display" "$(color_of_profile "$d")" "$claude_app"
  done
  install_watchdog --quiet --restart
  # Pre-bundle helper binary: a TCC-denied anonymous "tinticon".
  rm -f "$CACHE_DIR/tinticon"
  ensure_tint_tool >/dev/null || true
}

# ---- commands ---------------------------------------------------------------

cmd_add() {
  local raw="${1:-}" color=""
  [[ -n "$raw" ]] || err "Usage: cdp add <name> [--color <color>]   (e.g. cdp add personal --color blue)"
  [[ "${2:-}" == "--color" && -n "${3:-}" ]] && color="$3"
  local slug display data_dir app_path claude_app
  slug=$(slugify "$raw")
  [[ -n "$slug" ]] || err "Name must contain at least one letter or digit."
  display=$(displayify "$slug")
  data_dir="$APP_SUPPORT/Claude-$display"
  app_path="$LAUNCHER_DIR/Claude $display.app"
  claude_app=$(find_claude_app)

  # An existing data folder means this is a rebuild, not a new profile. It
  # doesn't prove sign-in ever finished; good enough to skip the login hint.
  local existed=0
  [[ -d "$data_dir" ]] && existed=1
  mkdir -p "$data_dir"

  # Recreating a launcher for an existing profile keeps its color unless a
  # new one is given explicitly.
  [[ -z "$color" ]] && color=$(color_of_profile "$data_dir")
  [[ -n "${HUES[$color]+x}" ]] || err "Unknown color '$color'. Available: ${(k)HUES}"
  print -- "$color" > "$data_dir/.cdp-color"

  build_launcher "$slug" "$display" "$color" "$claude_app"

  if (( existed )); then
    ok "Profile '$display' updated (color: $color)."
  else
    ok "Profile '$display' created (color: $color)."
  fi
  info "Data folder:  $data_dir"
  info "Launcher:     $app_path  (Spotlight: 'Claude $display')"
  if (( ! existed )); then
    print
    info "First launch: QUIT every other Claude window first (the claude:// login"
    info "deep link lands on whichever instance is running), open the launcher,"
    info "sign in, done. After that all profiles can run simultaneously."
  fi

  install_watchdog --quiet
  rebuild_chooser_unless_nested
}

cmd_chooser() {
  local claude_app tmp m
  # Same Spotlight name as the SwiftUI app: building here would replace or
  # duplicate the GUI.
  if [[ "${1:-}" != "--force" ]] && m=$(manager_app) && is_swiftui_manager "$m"; then
    err "The SwiftUI app is installed at $m; 'cdp chooser' would replace or duplicate it. Use 'cdp chooser --force' to build it anyway."
  fi
  claude_app=$(find_claude_app)
  tmp=$(mktemp -d)

  # The chooser discovers profiles at runtime by listing Claude-* folders, so
  # it never needs rebuilding when profiles change — we rebuild on `cdp add`
  # only to keep the bundled cdp copy, icon, and signature fresh.
  cat > "$tmp/chooser.applescript" <<'EOF'
property addLabel : "+   Add a profile…"
property removeLabel : "–   Remove a profile…"

on run
	set appSupport to POSIX path of (path to application support folder from user domain)
	repeat
		set names to profileNames(appSupport)
		set opts to {"Default"}
		repeat with n in names
			set end of opts to contents of n
		end repeat
		set end of opts to addLabel
		if (count of names) > 0 then set end of opts to removeLabel
		set choice to choose from list opts with title "Claude Profiles" with prompt "Launch Claude with profile:" default items {"Default"}
		if choice is false then return
		set choice to (item 1 of choice) as text
		if choice is addLabel then
			addProfile()
		else if choice is removeLabel then
			removeProfile(appSupport)
		else if choice is "Default" then
			do shell script "open -a Claude"
			return
		else
			try
				do shell script cdpCommand() & " launch " & quoted form of choice & " > /dev/null"
			on error msg
				display alert "Could not launch Claude " & choice message msg as critical
			end try
			return
		end if
	end repeat
end run

on profileNames(appSupport)
	set raw to do shell script "ls -d " & quoted form of appSupport & "Claude-*/ 2>/dev/null | sed 's|/$||; s|.*/Claude-||' ; true"
	if raw is "" then return {}
	return paragraphs of raw
end profileNames

-- The cdp script bundled inside this app's Resources. GUI actions shell out
-- to it so the CLI and the chooser share one implementation.
on cdpCommand()
	return "CDP_FROM_CHOOSER=1 /bin/zsh " & quoted form of (POSIX path of (path to me) & "Contents/Resources/cdp")
end cdpCommand

on addProfile()
	set dlg to display dialog "Profile name (e.g. personal, client-acme):" default answer "" with title "Add Claude profile"
	set rawName to text returned of dlg
	if rawName is "" then return
	try
		do shell script cdpCommand() & " add " & quoted form of rawName
	on error msg
		display alert "Could not create profile" message msg as critical
		return
	end try
	display dialog "Profile created — it's now in the list, and 'Claude " & rawName & "' is searchable in Spotlight." & return & return & "Before its FIRST sign-in: quit every other Claude window. The login link lands on whichever instance is running." with title "Add Claude profile" buttons {"OK"} default button "OK"
end addProfile

on removeProfile(appSupport)
	set names to profileNames(appSupport)
	if names is {} then return
	set sel to choose from list names with title "Remove Claude profile" with prompt "Which profile?"
	if sel is false then return
	set target to (item 1 of sel) as text
	set btn to button returned of (display dialog "Remove \"" & target & "\"?" & return & return & "Launcher Only deletes the Spotlight app but keeps chats, login, and settings — the profile stays in this list and can be launched or fully removed later." & return & return & "Delete Everything also erases the data folder. Permanent." with title "Remove Claude profile" buttons {"Cancel", "Delete Everything", "Launcher Only"} default button "Launcher Only" cancel button "Cancel")
	set flag to "--keep-data"
	if btn is "Delete Everything" then
		set check to display dialog "Really delete ALL data for \"" & target & "\" — chats, login, settings? This cannot be undone." with title "Remove Claude profile" buttons {"Cancel", "Delete"} default button "Cancel" cancel button "Cancel"
		set flag to "--delete-data"
	end if
	try
		do shell script cdpCommand() & " remove " & quoted form of target & " " & flag
	on error msg
		display alert "Could not remove profile" message msg as critical
	end try
end removeProfile
EOF
  compile_launcher "$tmp/chooser.applescript" "$LAUNCHER_DIR/$CHOOSER_NAME.app" "$BUNDLE_PREFIX.chooser" "$claude_app"
  rm -rf "$tmp"

  # Bundle this script so the chooser's add/remove buttons drive the exact
  # same code path as the CLI, then re-sign (the copy broke the seal again).
  bundle_cdp "$LAUNCHER_DIR/$CHOOSER_NAME.app"
  make_manager_icns "$claude_app" "$LAUNCHER_DIR/$CHOOSER_NAME.app/Contents/Resources/applet.icns" || true
  /usr/bin/codesign --force --sign - "$LAUNCHER_DIR/$CHOOSER_NAME.app" 2>/dev/null || true
  sync_install

  [[ "${1:-}" == "--quiet" ]] || ok "Chooser rebuilt: $LAUNCHER_DIR/$CHOOSER_NAME.app  (Spotlight: '$CHOOSER_NAME')"
}

# Launches the profile from its own Claude.app clone — so the running Dock
# tile wears the profile color and owns the window — or focuses the existing
# instance without spawning a new window (Claude's second-instance handler
# opens a window per repeated launch attempt, so we activate the PID
# directly instead).
launch_profile() {
  local raw="$1"
  local display data_dir color clone claude_app pid tool
  display=$(displayify "$(slugify "$raw")")
  data_dir="$APP_SUPPORT/Claude-$display"
  [[ -d "$data_dir" ]] || err "Profile '$display' not found. Create it with: cdp add $raw"
  color=$(color_of_profile "$data_dir")
  claude_app=$(find_claude_app)
  clone="$CLONES_DIR/Claude $display.app"

  pid=$(instance_pid "$data_dir")
  if [[ -n "$pid" ]]; then
    # Already running and isolated (matched by --user-data-dir). Only raise
    # its window. NEVER fall back to a bare `open`: `open` starts the clone
    # with no --user-data-dir and no CLAUDE_CONFIG_DIR, i.e. on the DEFAULT
    # identity — the exact cross-profile leak this tool exists to prevent.
    # If focus fails the instance is still up and isolated; the user clicks
    # its Dock tile. We refuse to launch anything unisolated.
    if tool=$(ensure_tint_tool) && "$tool" focus "$pid" 2>/dev/null; then
      return 0
    fi
    warn "Profile '$display' is running (pid $pid) but could not be focused. Click its Dock tile; not relaunching to avoid a non-isolated instance."
    return 0
  fi

  ensure_clone "$claude_app" "$clone" "$color"
  launch_clone "$clone" "$data_dir"
}

cmd_launch() {
  # The single launch path used by the Spotlight launchers, the GUI, and the
  # chooser. Re-homes any stray clone first so a post-update relaunch can't
  # keep serving the default account under a profile's name.
  local raw="${1:-}"
  [[ -n "$raw" ]] || err "Usage: cdp launch <name>"
  adopt_strays
  launch_profile "$raw"
}

cmd_watch() {
  # `cdp watch` loops forever (LaunchAgent); `cdp watch --once` is one pass.
  if [[ "${1:-}" == "--once" ]]; then
    adopt_strays
    return 0
  fi
  # zsh keeps the functions it parsed at start, so a long-lived watch would
  # run stale code forever after a `git pull`; re-exec when the file changes.
  local stamp
  stamp=$(stat -f %m "$SCRIPT_PATH")
  while :; do
    [[ "$(stat -f %m "$SCRIPT_PATH" 2>/dev/null)" == "$stamp" ]] ||
      exec /bin/zsh "$SCRIPT_PATH" watch
    adopt_strays
    sleep 3
  done
}

# Installs/removes the LaunchAgent that runs `cdp watch`. Idempotent: rewrites
# and reloads only when the plist content changed or the agent isn't loaded;
# --restart also restarts an up-to-date agent.
install_watchdog() {
  local quiet="${1:-}" restart="${2:-}" tmp
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$WATCH_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>$SCRIPT_PATH</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ProcessType</key><string>Background</string>
</dict>
</plist>
EOF
  local loaded=0
  launchctl print "gui/$(id -u)/$WATCH_LABEL" >/dev/null 2>&1 && loaded=1
  if (( loaded )) && cmp -s "$tmp" "$WATCH_PLIST"; then
    rm -f "$tmp"
    [[ "$restart" == "--restart" ]] && launchctl kickstart -k "gui/$(id -u)/$WATCH_LABEL"
    [[ "$quiet" == "--quiet" ]] || ok "Watchdog already installed: $WATCH_PLIST"
    return 0
  fi
  mkdir -p "${WATCH_PLIST:h}"
  (( loaded )) && launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null
  mv "$tmp" "$WATCH_PLIST"
  launchctl bootstrap "gui/$(id -u)" "$WATCH_PLIST"
  [[ "$quiet" == "--quiet" ]] || ok "Watchdog installed: $WATCH_PLIST (runs: cdp watch)"
}

uninstall_watchdog() {
  launchctl bootout "gui/$(id -u)/$WATCH_LABEL" 2>/dev/null || true
  rm -f "$WATCH_PLIST"
  ok "Watchdog removed."
}

cmd_watchdog() {
  case "${1:-status}" in
    install)   install_watchdog ;;
    uninstall) uninstall_watchdog ;;
    status)
      if launchctl print "gui/$(id -u)/$WATCH_LABEL" >/dev/null 2>&1; then
        ok "Watchdog loaded ($WATCH_LABEL)."
      else
        info "Watchdog not loaded. Install with: cdp watchdog install"
      fi
      local s
      s=$(stray_pids)
      [[ -n "$s" ]] && print -- "Strays:"$'\n'"$s" || info "No stray clones."
      ;;
    *) err "Usage: cdp watchdog [install|uninstall|status]" ;;
  esac
}

cmd_color() {
  local raw="${1:-}" color="${2:-}"
  [[ -n "$raw" && -n "$color" ]] || err "Usage: cdp color <name> <color>   Available: ${(k)HUES}"
  [[ -n "${HUES[$color]+x}" ]] || err "Unknown color '$color'. Available: ${(k)HUES}"
  local display data_dir app_path claude_app
  display=$(displayify "$(slugify "$raw")")
  data_dir="$APP_SUPPORT/Claude-$display"
  app_path="$LAUNCHER_DIR/Claude $display.app"
  [[ -d "$data_dir" ]] || err "Profile '$display' not found."
  claude_app=$(find_claude_app)

  print -- "$color" > "$data_dir/.cdp-color"
  ok "Color for '$display' set to $color."

  if [[ -f "$app_path/Contents/Resources/applet.icns" ]]; then
    make_icns "$claude_app" "$(hue_for_color "$color")" "$app_path/Contents/Resources/applet.icns" || true
    /usr/bin/codesign --force --sign - "$app_path" 2>/dev/null || true
    /usr/bin/touch "$app_path"
    ok "Launcher icon updated. (Finder/Dock may take a moment to refresh.)"
  else
    info "No launcher found; run 'cdp add $raw' to create one with this color."
  fi

  local clone="$CLONES_DIR/Claude $display.app"
  if [[ -d "$clone" ]]; then
    apply_clone_icon "$claude_app" "$clone" "$color"
    ok "Profile app icon updated. (Takes effect on next launch if running.)"
  fi
}

# Builds the SwiftUI manager app at $1 from a repo checkout: the GUI, a copy
# of this script and the prebuilt helper, ad-hoc signed. Used by `cdp gui`
# and by scripts/build.sh for the release.
build_manager_app() {
  local bundle="$1"
  command -v swiftc >/dev/null 2>&1 ||
    err "swiftc not found. Install Xcode Command Line Tools (xcode-select --install), or use 'cdp chooser' for the dialog-based picker."
  local src="${SCRIPT_PATH:h:h}/app/ClaudeProfiles.swift"
  [[ -f "$src" ]] ||
    err "GUI source not found at $src — run cdp from a repo checkout to build the GUI."

  rm -rf "$bundle"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
  info "Compiling ClaudeProfiles.swift (first build can take ~30s)…"
  swift_compile "$bundle/Contents/MacOS/ClaudeProfiles" -parse-as-library "$src" ||
    err "Compiling ClaudeProfiles.swift failed."
  build_helper "$bundle/Contents/Resources/$HELPER_NAME.app" || err "Compiling the helper failed."

  cat > "$bundle/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>$CHOOSER_NAME</string>
	<key>CFBundleDisplayName</key><string>$CHOOSER_NAME</string>
	<key>CFBundleIdentifier</key><string>$BUNDLE_PREFIX.gui</string>
	<key>CFBundleExecutable</key><string>ClaudeProfiles</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$CDP_VERSION</string>
	<key>CFBundleVersion</key><string>$CDP_VERSION</string>
	<key>LSMinimumSystemVersion</key><string>13.0</string>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF

  # Same trick as the chooser: bundle this script so the GUI's add/remove
  # drive the exact same code path as the CLI.
  bundle_cdp "$bundle"
  cp "${SCRIPT_PATH:h:h}/app/AppIcon.icns" "$bundle/Contents/Resources/AppIcon.icns"
  cp "${SCRIPT_PATH:h:h}/app/AppIcon.icns" "$bundle/Contents/Resources/$HELPER_NAME.app/Contents/Resources/AppIcon.icns"
  /usr/bin/codesign --force --sign - "$bundle/Contents/Resources/$HELPER_NAME.app"

  /usr/bin/codesign --force --sign - "$bundle"
}

cmd_gui() {
  # Builds the SwiftUI manager into ~/Applications, replacing the AppleScript
  # chooser at the same Spotlight name. Built locally on the user's machine,
  # so there is no notarization/quarantine problem.
  local app tmp bundle
  app="$LAUNCHER_DIR/$CHOOSER_NAME.app"
  tmp=$(mktemp -d)
  bundle="$tmp/$CHOOSER_NAME.app"
  build_manager_app "$bundle"

  mkdir -p "$LAUNCHER_DIR"
  # A running GUI keeps executing the replaced binary; restart it on the new one.
  local running=0
  pkill -f "$app/Contents/MacOS/ClaudeProfiles" 2>/dev/null && running=1
  rm -rf "$app"
  mv "$bundle" "$app"
  rm -rf "$tmp"
  sync_install
  (( running )) && open "$app"
  ok "GUI installed: $app  (Spotlight: '$CHOOSER_NAME')"
}

# Run by the manager app on every launch: the first time a version runs from
# a location (a fresh download, an update), points launchers, watchdog and
# helper at this copy of cdp.
cmd_setup() {
  # An app opened straight from Downloads runs from a randomized read-only
  # copy that vanishes on quit; the watchdog would point at nothing.
  [[ "$SCRIPT_PATH" != */AppTranslocation/* ]] ||
    err "Move Claude Profiles to your Applications folder, then open it again."
  local stamp="$CACHE_DIR/setup" want="$CDP_VERSION $SCRIPT_PATH"
  [[ "${1:-}" == "--if-needed" && "$(cat "$stamp" 2>/dev/null)" == "$want" ]] && return 0
  sync_install
  mkdir -p "$CACHE_DIR"
  print -- "$want" > "$stamp"
}

cmd_list() {
  local d found=0
  for d in "$APP_SUPPORT"/Claude-*(N/); do
    found=1
    local display="${${d:t}#Claude-}"
    local app="$LAUNCHER_DIR/Claude $display.app"
    if [[ -d "$app" ]]; then
      print -- "  $display\t$d\t(launcher ok)"
    else
      print -- "  $display\t$d\t(launcher MISSING — run: cdp add $(slugify "$display"))"
    fi
  done
  (( found )) || info "No profiles yet. Create one with: cdp add <name>"
}

cmd_remove() {
  local raw="${1:-}" mode="${2:-}"
  [[ -n "$raw" ]] || err "Usage: cdp remove <name> [--keep-data|--delete-data]"
  local display data_dir app_path
  display=$(displayify "$(slugify "$raw")")
  data_dir="$APP_SUPPORT/Claude-$display"
  app_path="$LAUNCHER_DIR/Claude $display.app"

  [[ -d "$app_path" ]] && { rm -rf "$app_path"; ok "Deleted launcher $app_path" }

  local clone="$CLONES_DIR/Claude $display.app"
  [[ -d "$clone" ]] && { rm -rf "$clone"; ok "Deleted profile app clone" }

  if [[ -d "$data_dir" ]]; then
    case "$mode" in
      --delete-data)
        rm -rf "$data_dir"
        ok "Deleted $data_dir"
        ;;
      --keep-data)
        info "Data folder kept: $data_dir"
        ;;
      *)
        print -n -- "Also delete data folder $data_dir (chats, login — permanent)? [y/N] "
        read -r answer
        if [[ "$answer" == [yY]* ]]; then
          rm -rf "$data_dir"
          ok "Deleted $data_dir"
        else
          info "Data folder kept. Re-create the launcher later with: cdp add $raw"
        fi
        ;;
    esac
  fi
  rebuild_chooser_unless_nested
}

cmd_help() {
  cat <<'EOF'
cdp — run multiple Claude Desktop accounts side by side on macOS

USAGE
  cdp add <name> [--color <c>]
                      Create a profile + Spotlight launcher
                      (e.g. cdp add personal --color blue)
  cdp launch <name>   Launch a profile (or focus it if already running).
                      Runs from a per-profile Claude.app clone, so the Dock
                      tile wears the profile color and owns the window, with
                      its own Claude Code config dir (CLAUDE_CONFIG_DIR)
  cdp watchdog [install|uninstall|status]
                      LaunchAgent that re-homes a clone relaunched without
                      its profile (Claude's self-update does that). Installed
                      automatically by cdp add
  cdp watch [--once]  What the watchdog runs
  cdp color <name> <c>
                      Change a profile's icon color
                      (orange red yellow green teal blue purple pink)
  cdp list            List profiles and launcher health
  cdp remove <name>   Remove a profile's launcher; add --keep-data or
                      --delete-data to skip the interactive question
  cdp gui             Build + install the "Claude Profiles" SwiftUI app
                      (needs Xcode Command Line Tools; run from repo checkout)
  cdp chooser         Build the AppleScript picker instead — zero build
                      requirements, same Spotlight name, fewer looks;
                      refuses to replace the SwiftUI app without --force
  cdp setup           Rebuild launchers, watchdog and helper from this cdp
                      (the app runs it when a new version first opens)
  cdp version         Print the version
  cdp help            This text

Profiles live in ~/Library/Application Support/Claude-<Name>; that profile's
Claude Code config (Code/Cowork tab) lives in <profile>/claude-config.
Launchers live in ~/Applications and are indexed by Spotlight.
EOF
}

# ---- dispatch ---------------------------------------------------------------

case "${1:-help}" in
  add)     shift; cmd_add "$@" ;;
  launch)  shift; cmd_launch "$@" ;;
  watch)   shift; cmd_watch "$@" ;;
  watchdog) shift; cmd_watchdog "$@" ;;
  color)   shift; cmd_color "$@" ;;
  list)    cmd_list ;;
  remove)  shift; cmd_remove "$@" ;;
  gui)     cmd_gui ;;
  chooser) shift; cmd_chooser "$@" ;;
  setup)   shift; cmd_setup "$@" ;;
  build)   shift; build_manager_app "${1:?Usage: cdp build <out.app>}" ;;
  version|--version) print -- "$CDP_VERSION" ;;
  help|-h|--help) cmd_help ;;
  *) err "Unknown command: $1 (try: cdp help)" ;;
esac
